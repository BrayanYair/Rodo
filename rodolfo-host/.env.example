# ═══════════════════════════════════════════════════════════════════════════
#  Rodolfo Host — Variables de entorno
#  Copia este archivo a `.env` y rellena los valores.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Conexión al bot (que corre en Hetzner) ─────────────────────────────────
# Reemplaza IP_VPS por la IP de tu servidor en Hetzner.
MUSIC_BOT_URL=http://IP_VPS:5000

# El MISMO token que pusiste en el .env del bot (rodolfo-bot/.env)
API_TOKEN=el_mismo_token_largo_aleatorio

# ─── Webhook de Discord (mensajes de texto opcionales) ───────────────────────
DISCORD_WEBHOOK_URL=

# ─── TTS — Voz que usa Rodolfo ──────────────────────────────────────────────
# Voces (es-ES-ElviraNeural | es-MX-DaliaNeural | es-PE-AlexNeural)
TTS_VOICE=es-MX-DaliaNeural

# ─── Dónde habla Rodolfo ─────────────────────────────────────────────────────
#   discord  → solo por el canal de voz (recomendado)
#   local    → solo en tu PC
#   both     → ambos (causa eco)
TTS_OUTPUT=discord

# ─── Chimes (sonidos cortos de confirmación) ─────────────────────────────────
CHIMES_ENABLED=false

# ─── STT (Whisper como fallback offline) ────────────────────────────────────
# Por defecto DESACTIVADO porque alucina con cortes de red.
# Pon true solo si tu internet es inestable.
WHISPER_FALLBACK=false
WHISPER_MODEL=small

# ─── Activador "Rodolfo" ─────────────────────────────────────────────────────
ACTIVATOR_REQUIRED=true

# ─── Wake Word (desactivado por defecto) ─────────────────────────────────────
WAKE_WORD_ENABLED=false
WAKE_WORD_THRESHOLD=0.3

# ─── Playlists guardadas (opcional) ──────────────────────────────────────────
# PLAYLIST_GAMING=https://open.spotify.com/playlist/...
# PLAYLIST_FIESTA=https://open.spotify.com/playlist/...
