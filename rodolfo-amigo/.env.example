# ═══════════════════════════════════════════════════════════════════════════
#  Rodolfo Amigo — Cliente liviano para amigos
#  Copia este archivo a `.env` y rellena los valores.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Tu nombre ────────────────────────────────────────────────────────────────
# Aparecerá en Discord o en los logs del servidor cuando hables.
NOMBRE=

# ─── MODO A: Discord webhook (modo actual — sin servidor propio) ───────────────
# El dueño del bot te da esta URL. El bot escucha los mensajes del canal.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# ─── MODO B: API directa (modo servidor — más rápido, sin Discord de por medio) ─
# Cuando el bot esté en un VPS, el dueño te da la URL y el token.
# Si rellenas esto, se ignora DISCORD_WEBHOOK_URL automáticamente.
BOT_API_URL=
BOT_API_TOKEN=
