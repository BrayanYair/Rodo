# ═══════════════════════════════════════════════════════════════════════════
#  Rodolfo Bot — Variables de entorno
#  Copia este archivo a `.env` y rellena los valores.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Discord ──────────────────────────────────────────────────────────────────
# Token del bot (Discord Developer Portal → tu app → Bot → Reset Token)
DISCORD_BOT_TOKEN=tu_token_aqui

# Tu ID de usuario (clic derecho a tu nombre en Discord con modo dev activado)
DISCORD_OWNER_USER_ID=

# ID del servidor donde va a operar (clic derecho al icono del server)
DISCORD_GUILD_ID=

# (Opcional) ID de canal de voz por defecto
DISCORD_VOICE_CHANNEL_ID=

# Webhook URL (para que los amigos usen rodolfo-amigo)
DISCORD_WEBHOOK_URL=

# ─── Spotify (opcional, para links open.spotify.com) ─────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── TTS ─────────────────────────────────────────────────────────────────────
# Voces: es-ES-ElviraNeural | es-MX-DaliaNeural | es-PE-AlexNeural
TTS_VOICE=es-MX-DaliaNeural

# ─── HTTP API ────────────────────────────────────────────────────────────────
# Puerto para que rodolfo-host se conecte
MUSIC_BOT_PORT=5000

# Token compartido entre el bot y el host para autenticar requests
# Genera uno aleatorio con:   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=cambiame_por_un_token_largo_aleatorio

# ─── Voice Messages ──────────────────────────────────────────────────────────
VOICE_MSG_ENABLED=true
WHISPER_MODEL=base

# ─── Voice Receive (DESACTIVADO por DAVE) ───────────────────────────────────
VOICE_LISTEN_ENABLED=false
